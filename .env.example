# Supabase / PostgreSQL Database URL (URI Format)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.irvpnvzbxeovhcbbwgrz.supabase.co:5432/postgres

# Direct ADO.NET Connection String for .NET / Npgsql
ConnectionStrings__DefaultConnection=Host=db.irvpnvzbxeovhcbbwgrz.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=[YOUR-PASSWORD];SSL Mode=Require;Trust Server Certificate=true

# PostgreSQL Details
POSTGRES_HOST=db.irvpnvzbxeovhcbbwgrz.supabase.co
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# JWT Security
JWT_SECRET=DuelloLabSuperSecretKeyThatIsAtLeast32CharactersLong!
